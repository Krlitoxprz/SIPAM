# ── SIPAM-USCO — Variables de entorno para producción ────────────────────────
# ⚠  SEGURIDAD: Cambia estas variables ANTES de exponer el servidor públicamente:
#   POSTGRES_PASSWORD  → contraseña única y fuerte para la BD
#   SECRET_KEY         → genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
#   ADMIN_PASSWORD     → contraseña segura del admin
#   CORS_ORIGINS       → IP/dominio real del servidor (no localhost)
#   FRONTEND_URL       → URL pública del servidor

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=sipam_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Sasuke24

# ── Backend FastAPI ──────────────────────────────────────────────────────────
SECRET_KEY=1e0dfbdf0663806a1d43c719d4185baf83b729a73c62a0b87d48f71c095a7ee7
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=False
ADMIN_PASSWORD=Sasuke24

# ── Archivos subidos ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS (URL pública del servidor Linux) ────────────────────────────────────
# Cambia TU_IP por la IP real del servidor Linux, ej: 192.168.1.50
CORS_ORIGINS=["http://localhost", "http://192.168.56.102"]
FRONTEND_URL=http://192.168.56.102

# ── Email SMTP (opcional — para recuperación de contraseña) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@usco.edu.co
SMTP_PASS=contrasena-app-gmail
SMTP_FROM=sipam@usco.edu.co
SMTP_TLS=True

# ── OpenRouteService (cálculo de rutas) — opcional ───────────────────────────
ORS_API_KEY=
